# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
REDIS_URL=redis://localhost:6379

# Application Configuration
APP_NAME=Weather Stock Dashboard
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Data Collection Settings
WEATHER_COLLECTION_INTERVAL=3600  # 1 hour in seconds
STOCK_COLLECTION_INTERVAL=900     # 15 minutes in seconds
DATA_RETENTION_DAYS=365

# Time Series Analysis Settings
MIN_DATA_POINTS_ARIMA=50
MIN_DATA_POINTS_GARCH=100
FORECAST_HORIZON_DAYS=30

# UI Configuration
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=false